---
import Base from '../layouts/Base.astro';
import {site} from '../data/site';
---
<Base title="Project enquiries"><div class="editorial-page content-width"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Workshop</a><span>/</span><span aria-current="page">Contact</span></nav><p class="eyebrow">PROJECT ENQUIRIES</p><h1>Discuss your<br/>project.</h1><p class="lead">Describe the gameplay system you need, the behavior you want to change, or the technical problem you need help investigating.</p><div class="editorial-grid"><section class="contact-panel"><h2>A direct conversation.</h2>{site.email?<a class="text-link" href={`mailto:${site.email}`}>{site.email} ↗</a>:<p>Public contact details are being added. This preview does not yet send enquiries.</p>}<p class="contact-note">Useful starting points: the player experience, what currently happens, the relevant constraints, and the kind of help you need.</p></section><div><form class="brief-form" data-brief><label>Project or working title<input name="project" autocomplete="off" required maxlength="120" placeholder="What are you building?"/></label><label>The system or problem<textarea name="problem" required maxlength="5000" placeholder="What should happen? What happens instead?"></textarea></label><label>Requirements & timing<textarea name="constraints" maxlength="3000" placeholder="Existing code, target devices, timeline, or anything else that matters."></textarea></label><button class="button button-primary" type="submit" hidden data-copy-brief>Copy project summary <span aria-hidden="true">↗</span></button><p class="brief-status" aria-live="polite"></p><noscript><p class="contact-note">You can select and copy your notes directly. Nothing is submitted by this preview.</p></noscript><p class="contact-note">A local drafting tool. Nothing is sent or stored by the site.</p></form></div></div></div><script>
 const form=document.querySelector<HTMLFormElement>('[data-brief]');const button=form?.querySelector<HTMLButtonElement>('[data-copy-brief]');
 if(form&&button){button.hidden=false;form.addEventListener('submit',async event=>{event.preventDefault();const data=new FormData(form);const brief=`Project: ${data.get('project')}\n\nSystem / problem:\n${data.get('problem')}\n\nRequirements & timing:\n${data.get('constraints')}`;const status=form.querySelector<HTMLElement>('.brief-status')!;try{await navigator.clipboard.writeText(brief);status.textContent='Summary copied. Paste it into your preferred conversation when contact details are available.';}catch{status.textContent='Clipboard access was unavailable. Select and copy your notes from the fields above.';}});}
</script></Base>
