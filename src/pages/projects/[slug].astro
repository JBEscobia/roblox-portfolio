---
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import PlayExplode from '../../components/PlayExplode.astro';
import ProjectEnvironment from '../../components/ProjectEnvironment.astro';
import { getProjects, type Project } from '../../lib/projects';
import {site} from '../../data/site';
export async function getStaticPaths(){return (await getProjects()).map(project=>({params:{slug:project.id},props:{project}}));}
interface Props {project: Project;}
const {project}=Astro.props; const p=project.data;
const next=(await getProjects()).find(n=>n.id===p.next)!;
---
<Base title={p.title} description={p.premise}>
  <article class:list={['case-study',p.accent]}>
    <header class="inner-hero">
      <ProjectEnvironment kind={p.accent}/>
      <div class="content-width">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Portfolio</a><span aria-hidden="true">/</span><a href="/#projects">Projects</a><span aria-hidden="true">/</span><span aria-current="page">{p.shortTitle}</span></nav>
        <p class="eyebrow">0{p.order} / {p.zone}</p>
        <div class="inner-title-row"><h1>{p.title}</h1><span class="mono">{p.status.label}</span></div>
        <p class="lede">{p.premise}</p>
        <ul class="tags">{p.capabilities.map(c=><li>{c}</li>)}</ul>
        <div class="project-meta"><span><i></i>{site.responsibility}</span><span>Implementation reviewed in code</span><span>Game recordings to be added</span></div>
      </div>
    </header>
    <div class="content-width">
      <nav class="case-jump-nav" aria-label="Project sections"><a href="#experience">Gameplay</a><a href="#features">Features</a><a href="#more-gameplay">More gameplay</a><a href="#engineering">Optional technical details</a></nav>
      <div id="experience" class="project-hero-grid">
        <div><Media id={p.hero}/><p class="responsibility-caption">{site.responsibilityNote}</p></div>
        <PlayExplode project={project} instance="case"/>
      </div>
      <section id="features">
        <h2 class="case-proof">{p.proof}</h2>
        <div class="technical-cases feature-overview">{p.features.map(f=><section class="technical-case"><div><h3>{f.title}</h3></div><div><p class="case-player">{f.description}</p>{f.note&&<p class="feature-note">{f.note}</p>}</div></section>)}</div>
      </section>
      <section class="supporting-media" id="more-gameplay">
        <p class="eyebrow">MORE FROM THE GAME</p><h2>Short gameplay demonstrations</h2>
        <div class="media-grid">{p.supporting.map(id=><Media id={id} compact/>)}</div>
      </section>
      <section class="enquiry-note"><h2>Have a feature in mind?</h2><p>Tell me what you want players to be able to do. I can discuss the implementation and answer detailed questions about this project.</p><a class="text-link" href="/contact/">Discuss your project ↗</a></section>
      <details id="engineering" class="engineering-details">
        <summary>How it works — optional technical details</summary>
        <div class="technical-cases">{p.cases.map((c,i)=><section class="technical-case" id={c.id}><div><p class="mono">0{i+1} / IMPLEMENTATION</p><h3>{c.title}</h3><p class="case-player">{c.player}</p><span class="evidence-badge mono">Reviewed in project code</span></div><div class="technical-body"><details class="implementation-detail"><summary>Technical details</summary><p>{c.technical}</p>{c.id==='ability-authority'&&<figure class="authority-diagram"><div><h4>01 / Owner client</h4><p>Request approval, play the movement locally, then report the final position.</p></div><div><h4>02 / Server</h4><p>Check the endpoint against history or geometric bounds, then accept or correct it.</p></div><div><h4>03 / Observer clients</h4><p>Receive and smooth the server’s replica state.</p></div><figcaption>Explanatory diagram based on the source audit. Endpoint checks do not re-simulate every movement step.</figcaption></figure>}</details><details><summary>Limitations and testing</summary><p>{c.tradeoff}</p></details></div></section>)}</div>
      </details>
      <details class="evidence-notes" id="evidence"><summary>Source review and testing notes</summary>{p.notes.map(n=><p>{n}</p>)}</details>
      {p.attribution&&<p class="responsibility-caption attribution"><strong>Attribution.</strong> {p.attribution}</p>}
      <a class="next-project" href={`/projects/${next.id}/`}><div><p class="mono">NEXT PROJECT / {next.data.zone}</p><h2>{next.data.title}</h2></div><span aria-hidden="true">↗</span></a>
    </div>
  </article>
</Base>
<script>
  // Retain direct links to existing implementation sections inside the disclosure.
  function revealLinkedSection(){
    let id: string;
    try { id=decodeURIComponent(location.hash.slice(1)); } catch { return; }
    const target=document.getElementById(id);
    if(!target)return;
    const ancestors: HTMLDetailsElement[]=[];
    let parent=target.parentElement;
    while(parent){if(parent instanceof HTMLDetailsElement)ancestors.push(parent);parent=parent.parentElement;}
    ancestors.forEach(detail=>detail.open=true);
    if(ancestors.length)target.scrollIntoView();
  }
  revealLinkedSection();
  addEventListener('hashchange',revealLinkedSection);
</script>
<style>
  .responsibility-caption{font-size:10px;color:var(--muted);margin-top:20px;max-width:680px}
  .feature-note{font-size:13px;line-height:1.7;color:var(--muted);margin-top:12px}
  .enquiry-note{margin-block:40px;max-width:680px}
  .enquiry-note h2{font-size:28px;margin-bottom:14px}
  .enquiry-note p{font-size:15px;line-height:1.7;margin-bottom:18px}
  .engineering-details>summary,.evidence-notes>summary{font-size:17px;font-weight:650;cursor:pointer;padding-block:12px;min-height:44px}
  .engineering-details>.technical-cases{margin-top:20px}
  .technical-body{min-width:0}
  .technical-body .authority-diagram{grid-template-columns:1fr}
</style>
