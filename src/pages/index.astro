---
import Base from '../layouts/Base.astro';
import Workshop from '../components/Workshop.astro';
import IntroGate from '../components/IntroGate.astro';
import ScrollCue from '../components/ScrollCue.astro';
import Landscape from '../components/Landscape.astro';
import ProjectSummary from '../components/ProjectSummary.astro';
import WorldTransition from '../components/WorldTransition.astro';
import {getProjects} from '../lib/projects';
import {services,site} from '../data/site';
const projects=await getProjects();
---
<Base title="Roblox systems development"><section class="descent" id="systems" aria-label="Portfolio introduction"><div class="hero"><Landscape/><Workshop/><IntroGate/><div class="hero-copy"><p class="eyebrow">{site.username} · Independent Roblox developer</p><h1>Gameplay &<br/>systems development<span>.</span></h1><p class="hero-description">Character movement, multiplayer interactions, <br/>and game worlds that remember your progress.</p><div class="hero-actions"><a class="button button-primary" href="#projects">Explore the projects <span aria-hidden="true">↓</span></a><a class="button button-quiet" href="/contact/">Contact <span aria-hidden="true">↗</span></a></div></div><a class="intro-skip" href="#projects">Skip introduction ↓</a><ScrollCue/></div></section>
<div id="projects">
<section class="about-strip content-width" id="about"><div class="about-side"><p class="eyebrow">ABOUT ME</p><ul class="about-facts"><span class="facts-studs" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span><li><span class="fact-figure">0{projects.length}</span><span class="fact-label">Games designed and built</span></li><li><span class="fact-figure">01</span><span class="fact-label">Developer &mdash; builds, UI and code</span></li></ul></div><div><h2>Built for fun.<br/>Made by me.</h2><p>{site.introduction}</p><p>{site.ownership}</p><a class="text-link" href="/about/">More about me ↗</a></div></section>
<section class="workshop-intro content-width"><div><p class="eyebrow">SELECTED PROJECTS</p><h2>See what I can build.<br/><span>Explore it in the games.</span></h2></div><div><p>Three independently developed Roblox games: custom movement, power-ups, and multiplayer physics, plus currencies, leaderboards, shops, and saved progress.</p><p class="muted">Start with the gameplay and feature overviews. <strong>How it works</strong> is there for a closer look, and detailed questions are welcome through project enquiries.</p></div></section>
</div>
<nav class="project-index content-width" aria-label="Project shortcuts">{projects.map(p=><a href={`#${p.id}`} class={p.data.accent}><span class="index-dot"></span><span><small class="mono">0{p.data.order} / {p.data.zone}</small>{p.data.shortTitle}</span><span class="index-arrow" aria-hidden="true">↘</span></a>)}</nav>
<div class="content-width projects-list">{projects.map((project,i)=><><WorldTransition from={i===0?'dirt':projects[i-1].data.accent} to={project.data.accent}/><ProjectSummary project={project} next={projects[i+1]?.data.title}/></>)}<WorldTransition from={projects[projects.length-1].data.accent} to="services"/></div>
<section class="capabilities-section" id="services"><div class="content-width"><p class="eyebrow">DEVELOPMENT SERVICES</p><div class="services-heading"><h2>Building game features<br/>and fixing difficult bugs.</h2><a class="button button-outline" href="/services/">How I can help ↗</a></div><div class="service-grid">{services.map((s,i)=><a href={`/projects/${s.project}/`}><span class="mono">0{i+1} / {s.tag}</span><h3>{s.title}&nbsp;<span>↗</span></h3><p>{s.description}</p></a>)}</div></div></section>

<section class="contact-cta content-width"><span class="mono">PROJECT ENQUIRIES</span><h2>Discuss your<br/>project<span>.</span></h2><a class="button button-primary" href="/contact/">Talk about your project ↗</a><div class="cta-studs" aria-hidden="true"><i></i><i></i><i></i><i></i></div></section></Base>
