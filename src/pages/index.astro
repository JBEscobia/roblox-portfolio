---
import Base from '../layouts/Base.astro';
import Workshop from '../components/Workshop.astro';
import IntroGate from '../components/IntroGate.astro';
import ScrollCue from '../components/ScrollCue.astro';
import Landscape from '../components/Landscape.astro';
import ProjectSummary from '../components/ProjectSummary.astro';
import WorldTransition from '../components/WorldTransition.astro';
import AssetsMade from '../components/AssetsMade.astro';
import {getProjects} from '../lib/projects';
import {site} from '../data/site';
const projects=await getProjects();
---
<Base title="Full-stack Roblox developer" description="FloppySide: full-stack Roblox developer. Gameplay previews of three independently developed games, Gravity Dash, Time Tag and ANTS!, plus models and animation."><section class="descent" id="systems" aria-label="Portfolio introduction"><div class="hero"><Landscape/><Workshop/><IntroGate/><div class="hero-copy"><p class="eyebrow">{site.username} · Roblox developer</p><h1>Full-stack<br/>Roblox developer<span>.</span></h1><p class="hero-description">Gameplay, systems, UI and builds: <br/>everything it takes to ship a game.</p><div class="hero-actions"><a class="button button-primary" href="#projects">See the work <span aria-hidden="true">↓</span></a></div></div><a class="intro-skip" href="#projects">Skip introduction ↓</a><ScrollCue/></div></section>
<div class="content-width projects-list" id="projects">{projects.map((project,i)=><><WorldTransition from={i===0?'dirt':projects[i-1].data.accent} to={project.data.accent}/><ProjectSummary project={project} next={projects[i+1]?.data.title ?? 'Assets made'}/></>)}<WorldTransition from={projects[projects.length-1].data.accent} to="anipal"/></div>
<AssetsMade/>

<section class="contact-cta content-width"><span class="mono">PROJECT ENQUIRIES</span><h2>Discuss your<br/>project<span>.</span></h2><a class="button button-primary" href="/contact/">Talk about your project ↗</a><div class="cta-studs" aria-hidden="true"><i></i><i></i><i></i><i></i></div></section></Base>
