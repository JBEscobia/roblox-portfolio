---
import {brick} from '../lib/illustrations';
import {planet,ship,island,tunnel} from '../lib/environments';
interface Props{kind:string;}
const {kind}=Astro.props;
const stars=Array.from({length:55},(_,i)=>({x:(i*197+19)%1440,y:(i*131+31)%830,r:i%6===0?2:1}));
---
<div class:list={['project-environment',`environment-${kind}`]} aria-hidden="true">
 {kind==='gravity'&&<svg viewBox="0 0 1440 1000" preserveAspectRatio="xMidYMid slice"><g fill="#c8deed">{stars.map(s=><circle cx={s.x} cy={s.y} r={s.r} opacity=".5"/>)}</g><g transform="translate(1330 270) rotate(-18) scale(1.2)" opacity=".8" set:html={planet()}/><g transform="translate(130 870) rotate(-27) scale(1.3)" opacity=".9" set:html={ship()}/><g transform="translate(1150 780) rotate(21) scale(.65)" opacity=".4" set:html={ship()}/></svg>}
 {kind==='time'&&<svg viewBox="0 0 1440 1000" preserveAspectRatio="xMidYMid slice"><g fill="none" stroke-width="2"><path class="time-flow" d="M-120 120C370 380 560-210 1000 45S1520 70 1600 390" stroke="#bd9de0"/><path class="time-flow flow-two" d="M-100 145C370 405 560-185 1000 70S1520 95 1600 415" stroke="#78bdbb"/><path class="time-flow" d="M-130 940C200 510 510 1190 925 840S1170 530 1530 800" stroke="#988cdb"/><path class="time-flow flow-two" d="M-130 965C200 535 510 1215 925 865S1170 555 1530 825" stroke="#69b7c4"/></g><g transform="translate(1250 180) rotate(-12)" opacity=".65" set:html={brick(0,0,104,52,22,'#746397')+brick(-56,25,52,52,22,'#537d8b')}/><g transform="translate(80 870) rotate(-10)" opacity=".5" set:html={brick(0,0,208,52,18,'#725f91')+brick(40,-20,104,26,18,'#4b8d9a')}/></svg>}
 {kind==='ants'&&<svg viewBox="0 0 1440 1000" preserveAspectRatio="xMidYMid slice"><g transform="translate(1320 90)" opacity=".65" set:html={tunnel()}/><g transform="translate(-110 665)" opacity=".75" set:html={tunnel()}/><g transform="translate(1270 805)" opacity=".8" set:html={brick(0,0,104,78,45,'#977052')+brick(-20,-33,78,52,28,'#ae845c')}/></svg>}
 {kind==='anipal'&&<svg viewBox="0 0 1440 1000" preserveAspectRatio="xMidYMid slice"><g fill="none" stroke="#b2e0db" opacity=".3" stroke-width="3"><path d="M-90 170Q170 65 365 175T820 150T1470 170"/><path d="M-90 190Q170 85 365 195T820 170T1470 190"/><path d="M-90 850Q220 710 465 840T910 780T1470 830"/><path d="M-90 870Q220 730 465 860T910 800T1470 850"/></g><g transform="translate(1370 295) scale(.9)" opacity=".85" set:html={island()}/><g transform="translate(-5 875) scale(1.15)" opacity=".9" set:html={island()}/><g transform="translate(1080 920) scale(.6)" opacity=".65" set:html={island()}/></svg>}
</div>
