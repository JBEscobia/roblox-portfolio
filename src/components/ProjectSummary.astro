---
import type { Project } from '../lib/projects';
import Media from './Media.astro';
import PlayExplode from './PlayExplode.astro';
import ProjectEnvironment from './ProjectEnvironment.astro';
import { site } from '../data/site';
import { media } from '../lib/media';
interface Props { project: Project; next?: string; }
const {project,next}=Astro.props; const p=project.data;
// The homepage also shows the project's other recorded gameplay clips under the lead one.
const moreClips=(p.supporting??[]).filter(id=>media.some(m=>m.id===id&&m.kind==='video'&&m.status!=='placeholder'));
---
<section id={project.id} class:list={['project-section',p.accent]}>
 <ProjectEnvironment kind={p.accent}/>
 <div class="section-rule"><span class="mono">0{p.order} / {p.zone}</span>{p.status.evidence!=='status-confirmation-required'&&<span class="mono">{p.status.label}</span>}</div>
 <div class="project-heading"><span class="project-serial" aria-hidden="true">0{p.order}</span><div><p class="eyebrow">{p.title}</p><h2>{p.headline}</h2></div><p class="project-premise">{p.premise}</p></div>
 <div class="project-grid"><div class="project-evidence"><ul class="tags" aria-label={`${p.title} features`}>{p.capabilities.map(c=><li>{c}</li>)}</ul><Media id={p.hero}/>{moreClips.length>0&&<div class="more-clips">{moreClips.map(id=><Media id={id} compact/>)}</div>}<div class="project-evidence-footer"><span class="mono">{site.responsibility}</span>{p.playUrl&&<a class="text-link play-link" href={p.playUrl} target="_blank" rel="noopener">Play on Roblox <span aria-hidden="true">↗</span></a>}<a class="text-link" href={`/projects/${project.id}/`}>Explore {p.shortTitle}</a></div></div><PlayExplode project={project}/></div>
 <div class="handoff mono" aria-hidden="true"><span></span>{next?'NEXT: '+next.toUpperCase():'HOW I CAN HELP'}<span>↓</span></div>
</section>
<style>.more-clips{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;margin-top:14px}</style>
