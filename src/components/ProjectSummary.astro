---
import type { Project } from '../lib/projects';
import Media from './Media.astro';
import PlayExplode from './PlayExplode.astro';
import ProjectEnvironment from './ProjectEnvironment.astro';
import { site } from '../data/site';
interface Props { project: Project; }
const {project}=Astro.props; const p=project.data;
---
<section id={project.id} class:list={['project-section',p.accent]}>
 <ProjectEnvironment kind={p.accent}/>
 <div class="section-rule"><span class="mono">0{p.order} / {p.zone}</span><span class="mono">{p.status.label}</span></div>
 <div class="project-heading"><span class="project-serial" aria-hidden="true">0{p.order}</span><div><p class="eyebrow">{p.title}</p><h2>{p.headline}</h2></div><p class="project-premise">{p.premise}</p></div>
 <div class="project-grid"><div class="project-evidence"><ul class="tags" aria-label={`${p.title} features`}>{p.capabilities.map(c=><li>{c}</li>)}</ul><Media id={p.hero}/><div class="project-evidence-footer"><span class="mono">{site.responsibility}</span><a class="text-link" href={`/projects/${project.id}/`}>Explore {p.shortTitle} <span aria-hidden="true">↗</span></a></div></div><PlayExplode project={project}/></div>
 <div class="handoff mono" aria-hidden="true"><span></span>{p.order===1?'NEXT: TIME TAG':p.order===2?'NEXT: ANTS!':p.order===3?'NEXT: ANIPAL ARCHIPELAGO':'HOW I CAN HELP'}<span>↓</span></div>
</section>
