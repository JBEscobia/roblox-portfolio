---
interface Props{from:string;to:string;}
const {from,to}=Astro.props;
const themes:Record<string,string>= {
 dirt:'#d2b087',
 gravity:'#20374e',
 time:'#332e48',
 ants:'#65462f',
 anipal:'#21647b',
 services:'#a5b07a',
};
const a=themes[from],b=themes[to];
function blend(x:string,y:string,t:number){const channels=[1,3,5].map(i=>Math.round(parseInt(x.slice(i,i+2),16)*(1-t)+parseInt(y.slice(i,i+2),16)*t));return '#'+channels.map(c=>c.toString(16).padStart(2,'0')).join('');}
// Every row is a single flat colour and a fixed 120x68 brick, so each row is one
// tiled pattern rather than 17 separately emitted bricks. Same artwork, ~11 nodes
// per row instead of ~187, and it now covers viewports wider than the old fixed
// 17-column run.
const rows=Array.from({length:4},(_,row)=>({id:`brick-${from}-${to}-${row}`,y:row*68,shift:(row%2)*-60,color:blend(a,b,row/3)}));
---
<div class="world-transition" aria-hidden="true" style={`--world-from:${a};--world-to:${b}`}><svg width="100%" height="272">
 <defs>
  {rows.map(row=><pattern id={row.id} width="120" height="68" patternUnits="userSpaceOnUse" patternTransform={`translate(${row.shift} 0)`}><rect x="1" y="9" width="118" height="57" rx="4" fill={row.color}/><rect x="1" y="9" width="118" height="57" rx="4" fill="#fff" opacity=".035"/><path d="M5 65H115Q119 65 119 60V16" fill="none" stroke="#172023" stroke-opacity=".14" stroke-width="2"/><path d="M5 10H115" stroke="#fff" stroke-opacity=".18"/><g fill={row.color}><path d="M21 11V6H43V11A11 4 0 0 1 21 11M77 11V6H99V11A11 4 0 0 1 77 11" stroke="#172023" stroke-opacity=".1"/><ellipse cx="32" cy="6" rx="11" ry="4"/><ellipse cx="88" cy="6" rx="11" ry="4"/><ellipse cx="32" cy="6" rx="11" ry="4" fill="#fff" opacity=".13"/><ellipse cx="88" cy="6" rx="11" ry="4" fill="#fff" opacity=".13"/></g></pattern>)}
 </defs>
 {rows.map((row,i)=><rect class={`wall-row wall-row-${i}`} x="0" y={row.y} width="100%" height="68" fill={`url(#${row.id})`}/>)}
 </svg></div>
